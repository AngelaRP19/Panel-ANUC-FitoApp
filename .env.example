VITE_API_URL=/api/v1
# Amazon Cognito (User Pool del panel). Obligatorios si VITE_USE_MOCKS=false.
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
# true: simula la API (MSW) y Cognito en el navegador, sin backend
VITE_USE_MOCKS=true
# Google Maps JavaScript API (mapas de fincas, casos y alertas). Sin clave, los mapas se
# muestran esquemáticos. Restringe la clave por referente HTTP (dominio del panel y localhost).
VITE_GOOGLE_MAPS_API_KEY=
